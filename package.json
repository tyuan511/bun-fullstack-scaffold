{
  "name": "bun-fullstack-scaffold",
  "version": "1.0.0",
  "description": "Bun Fullstack 脚手架 — 基于 Bun 原生全栈、ElysiaJS 2.0、React 19、Shadcn UI 与 Better Auth 的高性能工程化脚手架",
  "author": "tyuan511 <tangge0601@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:css && bun --watch src/server/index.ts",
    "build:css": "tailwindcss -i src/client/index.css -o public/styles.css --minify",
    "watch:css": "tailwindcss -i src/client/index.css -o public/styles.css --watch",
    "build:binary": "bun run build:css && bun build --compile --minify src/server/index.ts --outfile bun-fullstack-app",
    "build:linux": "bun run build:css && bun build --compile --minify --target=bun-linux-x64 src/server/index.ts --outfile bun-fullstack-app-linux",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "docker:build": "docker build -t bun-fullstack-scaffold .",
    "docker:run": "docker run -d -p 3000:3000 -v $(pwd)/data:/app/data --name bun-fullstack-app bun-fullstack-scaffold",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@elysia/openapi": "^2.0.0-rc.0",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/static": "^1.4.10",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "^1.7.13",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^2.0.0-rc.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.2"
  }
}
